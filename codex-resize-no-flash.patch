+            super::resize_viewport_for_frame(&mut terminal, Rect::new(0, 0, width, 8), true)
+                .unwrap();
+            assert_eq!(
+                terminal.backend().vt100().screen().contents(),
+                before,
+                "resize must not expose a blank screen before the replacement frame"
+            );
+            terminal
+                .draw_with_size(Size::new(width, 8), &mut Vec::new(), |frame| {
