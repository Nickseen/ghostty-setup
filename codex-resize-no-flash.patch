+        use ratatui::layout::Size;
+        use ratatui::widgets::{Paragraph, Widget};
+        let mut terminal = CustomTerminal::with_options(VT100Backend::new(40, 8)).unwrap();
+        terminal.set_viewport_area(Rect::new(0, 0, 40, 8));
