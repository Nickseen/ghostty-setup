+/// Keep the last fullscreen frame visible while the next (possibly image-heavy)
+/// frame is being prepared. Resize can cancel tmux's synchronized-update mode,
+/// exposing any early clear before rendering has finished.
+fn resize_viewport_for_frame<B>(
+    terminal: &mut CustomTerminal<B>,
+    new_area: Rect,
+    owned_screen: bool,
+) -> Result<()>
+where
+    B: Backend<Error = io::Error> + Write,
+{
+    if !owned_screen {
+        clear_for_viewport_change(terminal, new_area)?;
+    }
+    terminal.set_viewport_area(new_area);
+    if owned_screen {
+        terminal.invalidate_viewport();
+    }
+    Ok(())
+}
