 //! Read native image representations in macOS pasteboard item order.
 
+use super::EncodedImageFormat;
+use super::PastedImageInfo;
 use crate::image_decode::decode_oriented;
 use image::DynamicImage;
+use image::ImageDecoder;
 use image::ImageFormat;
 use image::ImageReader;
 use image::Limits;
+use image::metadata::Orientation;
 use objc2_app_kit::NSPasteboard;
 use objc2_app_kit::NSPasteboardItem;
 use objc2_foundation::NSArray;
@@ -12,6 +16,55 @@ use objc2_foundation::NSString;
 use objc2_foundation::ns_string;
 use std::io::Cursor;
 
+pub(super) fn clipboard_png() -> Option<(Vec<u8>, PastedImageInfo)> {
+    objc2::rc::autoreleasepool(|_| {
+        let items = NSPasteboard::generalPasteboard().pasteboardItems()?;
+        first_encoded_png(&items)
+    })
+}
+
+fn first_encoded_png(items: &NSArray<NSPasteboardItem>) -> Option<(Vec<u8>, PastedImageInfo)> {
+    for item in items {
+        let types = item.types();
+        if types.containsObject(ns_string!("public.png"))
+            && let Some(bytes) = item.dataForType(ns_string!("public.png"))
+            && let Some(encoded) = encoded_png(bytes.to_vec())
+        {
+            return Some(encoded);
+        }
+        // Don't skip an earlier JPEG/TIFF to paste a different item's PNG.
+        if types.containsObject(ns_string!("public.jpeg"))
+            || types.containsObject(ns_string!("public.tiff"))
+        {
+            return None;
+        }
+    }
+    None
+}
+
+fn encoded_png(bytes: Vec<u8>) -> Option<(Vec<u8>, PastedImageInfo)> {
+    let mut decoder = ImageReader::with_format(Cursor::new(&bytes), ImageFormat::Png)
+        .into_decoder()
+        .ok()?;
+    // Preserve the existing allocation ceiling and orientation behavior. Images
+    // requiring a transform take the normal decode/encode path instead.
+    let mut limits = Limits::default();
+    limits.reserve(decoder.total_bytes()).ok()?;
+    if decoder.orientation().ok()? != Orientation::NoTransforms {
+        return None;
+    }
+    let (width, height) = decoder.dimensions();
+    drop(decoder);
+    Some((
+        bytes,
+        PastedImageInfo {
+            width,
+            height,
+            encoded_format: EncodedImageFormat::Png,
+        },
+    ))
+}
+
 /// Decode an offered PNG or JPEG before falling back to [arboard's macOS image reader].
 /// That reader requests TIFF even when the pasteboard already holds the original PNG or
 /// JPEG. Clipboard owners such as Vicinae then generate a large TIFF just for this paste.
