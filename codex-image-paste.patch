         Some(DynamicImage::new_rgb8(/*width*/ 3, /*height*/ 1))
     );
 }
+
+#[test]
+fn image_paste_latency_png_preserves_bytes_and_precedence() {
+    let bytes = encoded(ImageFormat::Png, 4);
+    let png = item(ns_string!("public.png"), &bytes);
+    let (copied, info) = first_encoded_png(&NSArray::from_retained_slice(&[png])).unwrap();
+    assert_eq!(copied, bytes);
+    assert_eq!((info.width, info.height), (4, 1));
+    assert_eq!(info.encoded_format, super::super::EncodedImageFormat::Png);
+    let tiff = item(ns_string!("public.tiff"), b"earlier image");
+    let png = item(ns_string!("public.png"), &bytes);
+    assert!(first_encoded_png(&NSArray::from_retained_slice(&[tiff, png])).is_none());
+    assert!(encoded_png(b"invalid PNG".to_vec()).is_none());
+}
+
+#[test]
+fn image_paste_latency_png_orientation_uses_normalization_fallback() {
+    let pixels = DynamicImage::new_rgb8(3, 2);
+    let mut bytes = Vec::new();
+    // EXIF orientation 6 (90 degrees clockwise), little-endian TIFF header.
+    let exif = vec![
+        0x49, 0x49, 42, 0, 8, 0, 0, 0, 1, 0, 0x12, 1, 3, 0, 1, 0, 0, 0, 6, 0, 0, 0, 0, 0, 0, 0,
+    ];
+    use image::ImageEncoder;
+    let mut encoder = image::codecs::png::PngEncoder::new(&mut bytes);
+    encoder.set_exif_metadata(exif).unwrap();
+    pixels.write_with_encoder(encoder).unwrap();
+    assert!(encoded_png(bytes).is_none());
+}
+
+#[test]
+#[ignore = "manual timing; no wall-clock assertion on shared CI hosts"]
+fn image_paste_latency_benchmark() {
+    use std::time::Instant;
+    let mut fixture = image::RgbImage::new(2560, 1440);
+    for (x, y, pixel) in fixture.enumerate_pixels_mut() {
+        *pixel = image::Rgb([(x % 256) as u8, (y % 256) as u8, ((x + y) % 256) as u8]);
+    }
+    let image = DynamicImage::ImageRgb8(fixture);
+    let mut png = Cursor::new(Vec::new());
+    image.write_to(&mut png, ImageFormat::Png).unwrap();
+    let png = png.into_inner();
+    let start = Instant::now();
+    let decoded = decode_oriented(
+        ImageReader::with_format(Cursor::new(&png), ImageFormat::Png),
+        Limits::default(),
+    )
+    .unwrap();
+    let mut reencoded = Cursor::new(Vec::new());
+    decoded.write_to(&mut reencoded, ImageFormat::Png).unwrap();
+    let old = start.elapsed();
+    let start = Instant::now();
+    let (_, info) = encoded_png(png.clone()).unwrap();
+    let new = start.elapsed();
+    assert_eq!((info.width, info.height), (2560, 1440));
+    eprintln!("PNG paste processing: old={old:?}, original-bytes={new:?}");
+}
