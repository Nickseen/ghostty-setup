+    fn mouse_action(&mut self, mouse: MouseEvent, now: Instant) -> MouseAction {
+        if mouse.kind != MouseEventKind::Down(MouseButton::Left) || !mouse.modifiers.is_empty() {
+            if matches!(
+                mouse.kind,
+                MouseEventKind::Down(_) | MouseEventKind::ScrollUp | MouseEventKind::ScrollDown
+            ) {
+                self.last_click = None;
+            }
+            return MouseAction::None;
+        }
+        let point = (mouse.column, mouse.row).into();
+        if !self
+            .painted_frame
+            .is_some_and(|frame| frame.contains(point))
+        {
+            self.last_click = None;
+            return MouseAction::None;
+        }
+        if !self
+            .painted_image
+            .is_some_and(|image| image.contains(point))
+        {
+            self.last_click = None;
+            return MouseAction::Close;
+        }
+        let double = self.last_click.take().is_some_and(|(previous, x, y)| {
+            now.saturating_duration_since(previous) <= Duration::from_millis(500)
+                && x.abs_diff(mouse.column) <= 1
+                && y.abs_diff(mouse.row) <= 1
+        });
+        if double {
+            MouseAction::Copy
+        } else {
+            self.last_click = Some((now, mouse.column, mouse.row));
+            MouseAction::None
+        }
+    }
