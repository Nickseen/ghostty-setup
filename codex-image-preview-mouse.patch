+#[cfg(not(target_os = "android"))]
+fn read_original_image(path: &std::path::Path) -> Result<image::RgbaImage, String> {
+    let reader = image::ImageReader::open(path)
+        .map_err(|e| e.to_string())?
+        .with_guessed_format()
+        .map_err(|e| e.to_string())?;
+    crate::image_decode::decode_oriented(reader, image::Limits::default())
+        .map(|image| image.into_rgba8())
+        .map_err(|e| e.to_string())
+}
+
+#[cfg(not(target_os = "android"))]
+fn copy_original_image(path: &std::path::Path) -> Result<ClipboardImage, String> {
+    let image = read_original_image(path)?;
+    let mut clipboard = arboard::Clipboard::new().map_err(|e| e.to_string())?;
+    clipboard
+        .set_image(arboard::ImageData {
+            width: image.width() as usize,
+            height: image.height() as usize,
+            bytes: std::borrow::Cow::Owned(image.into_raw()),
+        })
+        .map_err(|e| e.to_string())?;
+    Ok(clipboard)
+}
+
+#[cfg(target_os = "android")]
+fn copy_original_image(_: &std::path::Path) -> Result<ClipboardImage, String> {
+    Err("Копирование изображений недоступно на Android".into())
+}
