+use super::*;
+use crossterm::event::KeyModifiers;
+
+fn click(x: u16, y: u16) -> MouseEvent {
+    MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: x,
+        row: y,
+        modifiers: KeyModifiers::NONE,
+    }
+}
+fn painted() -> ImagePreview {
+    let mut view = ImagePreview::new("unused.png".into(), ImageProtocol::Kitty);
+    view.painted_frame = Some(Rect::new(0, 0, 80, 24));
+    view.painted_image = Some(Rect::new(10, 5, 40, 12));
+    view
+}
+
+#[test]
+fn image_click_preview_background_closes_but_image_and_unpainted_areas_do_not() {
+    let now = Instant::now();
+    let mut view = painted();
+    assert_eq!(view.mouse_action(click(10, 5), now), MouseAction::None);
+    assert_eq!(view.mouse_action(click(9, 5), now), MouseAction::Close);
+    assert_eq!(view.mouse_action(click(50, 5), now), MouseAction::Close);
+    assert_eq!(view.mouse_action(click(20, 17), now), MouseAction::Close);
+    assert_eq!(view.mouse_action(click(80, 5), now), MouseAction::None);
+    view.painted_frame = None;
+    assert_eq!(view.mouse_action(click(5, 5), now), MouseAction::None);
+}
+
+#[test]
+fn image_click_preview_double_click_copies_without_closing_or_triple_click_repeat() {
+    let now = Instant::now();
+    let mut view = painted();
+    assert_eq!(view.mouse_action(click(20, 10), now), MouseAction::None);
+    let mut release = click(20, 10);
+    release.kind = MouseEventKind::Up(MouseButton::Left);
+    assert_eq!(view.mouse_action(release, now), MouseAction::None);
+    assert_eq!(
+        view.mouse_action(click(21, 10), now + Duration::from_millis(200)),
+        MouseAction::Copy
+    );
+    assert!(!view.is_done);
+    assert_eq!(
+        view.mouse_action(click(20, 10), now + Duration::from_millis(300)),
+        MouseAction::None
+    );
+}
+
+#[test]
+fn image_click_preview_separate_slow_modified_or_right_clicks_do_not_copy() {
+    let now = Instant::now();
+    let mut view = painted();
+    assert_eq!(view.mouse_action(click(20, 10), now), MouseAction::None);
+    assert_eq!(
+        view.mouse_action(click(20, 10), now + Duration::from_secs(1)),
+        MouseAction::None
+    );
+    assert_eq!(
+        view.mouse_action(click(30, 10), now + Duration::from_millis(1200)),
+        MouseAction::None
+    );
+    let mut modified = click(30, 10);
+    modified.modifiers = KeyModifiers::SHIFT;
+    assert_eq!(view.mouse_action(modified, now), MouseAction::None);
+    let mut right = click(30, 10);
+    right.kind = MouseEventKind::Down(MouseButton::Right);
+    assert_eq!(view.mouse_action(right, now), MouseAction::None);
+    assert_eq!(view.mouse_action(click(30, 10), now), MouseAction::None);
+}
+
+#[test]
+fn image_click_preview_copy_reads_original_resolution_and_rgba_pixels() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("original.png");
+    let image =
+        image::RgbaImage::from_fn(800, 600, |x, y| image::Rgba([x as u8, y as u8, 90, 180]));
+    image.save(&path).unwrap();
+    assert_eq!(read_original_image(&path).unwrap(), image);
+    assert!(read_original_image(&dir.path().join("missing.png")).is_err());
+}
+
+#[tokio::test]
+async fn image_click_preview_rendered_padding_returns_to_chat_and_copy_failure_is_visible() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("wide.png");
+    image::RgbaImage::new(800, 100).save(&path).unwrap();
+    let mut view = ImagePreview::new(path, ImageProtocol::Kitty);
+    let mut tui = crate::tui::test_support::make_test_tui().unwrap();
+    tui.set_owned_screen(true).unwrap();
+    tui.terminal
+        .resize(ratatui::layout::Size::new(80, 24))
+        .unwrap();
+    view.handle_event(&mut tui, TuiEvent::Draw).unwrap();
+    let bounds = view.painted_image.unwrap();
+    assert!(bounds.y > 1, "wide image leaves a clickable top margin");
+    view.handle_event(&mut tui, TuiEvent::Mouse(click(bounds.x, bounds.y)))
+        .unwrap();
+    assert!(!view.is_done);
+    view.handle_event(&mut tui, TuiEvent::FocusLost).unwrap();
+    assert!(view.last_click.is_none());
+    let (send, receive) = mpsc::channel();
+    view.copy_pending = Some(receive);
+    send.send(Err("test copy failure".into())).unwrap();
+    view.handle_event(&mut tui, TuiEvent::Draw).unwrap();
+    assert!(
+        view.feedback
+            .as_ref()
+            .unwrap()
+            .contains("test copy failure")
+    );
+    assert!(view.copy_pending.is_none());
+    view.handle_event(&mut tui, TuiEvent::Mouse(click(1, 1)))
+        .unwrap();
+    assert!(view.is_done);
+}
