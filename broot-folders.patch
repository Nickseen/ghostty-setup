@@ -0,0 +1,87 @@
+//! Per-folder disclosure state for the personal Broot build.
+use std::{
+    collections::HashSet,
+    path::{Path, PathBuf},
+};
+
+#[derive(Debug, Clone, Default)]
+pub struct FolderFolding {
+    expanded: HashSet<PathBuf>,
+    search_collapsed: HashSet<PathBuf>,
+}
+
+impl FolderFolding {
+    pub fn from_env() -> Option<Self> {
+        (std::env::var("BROOT_CLICK_FOLDERS").as_deref() == Ok("1")).then(Self::default)
+    }
+
+    pub fn is_open(
+        &self,
+        path: &Path,
+        searching: bool,
+    ) -> bool {
+        if searching {
+            !self.search_collapsed.contains(path)
+        } else {
+            self.expanded.contains(path)
+        }
+    }
+
+    pub fn toggle(
+        &mut self,
+        path: &Path,
+        searching: bool,
+    ) {
+        if searching {
+            if !self.search_collapsed.remove(path) {
+                self.search_collapsed.insert(path.to_path_buf());
+            }
+        } else if !self.expanded.remove(path) {
+            self.expanded.insert(path.to_path_buf());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn folders_start_closed_and_toggle_independently() {
+        let mut state = FolderFolding::default();
+        let a = Path::new("/project/Папка with spaces");
+        let b = Path::new("/project/other");
+        assert!(!state.is_open(a, false));
+        state.toggle(a, false);
+        assert!(state.is_open(a, false));
+        assert!(!state.is_open(b, false));
+        state.toggle(a, false);
+        assert!(!state.is_open(a, false));
+    }
+
+    #[test]
+    fn search_discovers_closed_folders_without_losing_normal_state() {
+        let mut state = FolderFolding::default();
+        let path = Path::new("/project/nested");
+        assert!(state.is_open(path, true));
+        assert!(!state.is_open(path, false));
+        state.toggle(path, true);
+        assert!(!state.is_open(path, true));
+        state.toggle(path, false);
+        assert!(state.is_open(path, false));
+        assert!(!state.is_open(path, true));
+    }
+
+    #[test]
+    fn a_closed_parent_retains_the_child_expansion_state() {
+        let mut state = FolderFolding::default();
+        let parent = Path::new("/project/a");
+        let child = Path::new("/project/a/b");
+        state.toggle(parent, false);
+        state.toggle(child, false);
+        state.toggle(parent, false);
+        let restored = state.clone();
+        assert!(!restored.is_open(parent, false));
+        assert!(restored.is_open(child, false));
+    }
+}
