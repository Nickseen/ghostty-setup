@@ -0,0 +1,115 @@
+//! Attachment hits resolve by painted coordinates, keep drafts intact, and never submit a turn.
+use super::*;
+use crate::history_cell::HistoryCell;
+use crate::pets::{ImageProtocol, PetImageSupport};
+use crossterm::event::{MouseButton, MouseEvent, MouseEventKind};
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn image_click_preview_thumbnail_and_draft_label_preserve_input() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let path = dir.path().join("sample.png");
+    image::RgbaImage::from_pixel(800, 600, image::Rgba([23, 99, 210, 255])).save(&path)?;
+    let mut app = crate::app::test_support::make_test_app().await;
+    app.chat_widget
+        .set_pet_image_support_for_tests(PetImageSupport::Supported(ImageProtocol::Kitty));
+    app.chat_widget.handle_paste("Описание: ".into());
+    app.chat_widget
+        .attach_image(path.clone(), ClipboardPasteContext::DraftHandoff);
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    tui.set_owned_screen(true)?;
+    let size = ratatui::layout::Size::new(80, 24);
+    tui.terminal.resize(size)?;
+    app.render_owned_transcript(&mut tui, size)?;
+    let before = app.chat_widget.capture_thread_input_state();
+    let buffer = crate::custom_terminal::test_support::last_rendered_buffer(&tui.terminal);
+    let label = buffer
+        .area
+        .positions()
+        .find(|pos| {
+            pos.x + 1 < buffer.area.right()
+                && buffer[*pos].symbol() == "["
+                && buffer[(pos.x + 1, pos.y)].symbol() == "I"
+        })
+        .expect("image label is painted");
+    let thumbnail = tui.retained_images.first().expect("thumbnail painted").area;
+    for position in [(thumbnail.x, thumbnail.y), (label.x + 2, label.y)] {
+        assert!(app.preview_composer_image(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: position.0,
+            row: position.1,
+            modifiers: KeyModifiers::NONE,
+        }));
+        let overlay = app.overlay.as_mut().expect("image overlay opened");
+        overlay.handle_event(&mut tui, TuiEvent::Draw)?;
+        let large = tui
+            .retained_images
+            .first()
+            .expect("full size image painted");
+        assert!(large.area.width > thumbnail.width * 3);
+        assert!(large.area.height > thumbnail.height * 3);
+        overlay.handle_event(&mut tui, TuiEvent::Key(KeyCode::Esc.into()))?;
+        assert!(overlay.is_done());
+        app.close_transcript_overlay(&mut tui);
+        assert_eq!(app.chat_widget.capture_thread_input_state(), before);
+        app.render_owned_transcript(&mut tui, size)?;
+    }
+    assert!(!app.preview_composer_image(MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: label.x,
+        row: label.y,
+        modifiers: KeyModifiers::SHIFT,
+    }));
+    Ok(())
+}
+
+#[tokio::test]
+async fn image_click_preview_sent_labels_open_their_own_attachment() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let paths: Vec<_> = ["one.png", "two.png"]
+        .into_iter()
+        .map(|name| dir.path().join(name))
+        .collect();
+    for path in &paths {
+        image::RgbaImage::new(10, 10).save(path)?;
+    }
+    let message = "Привет [Image #1] и [Image #2]".to_string();
+    let text_elements = ["[Image #1]", "[Image #2]"]
+        .into_iter()
+        .map(|label| {
+            let start = message.find(label).expect("attachment label");
+            codex_protocol::user_input::TextElement::new(
+                (start..start + label.len()).into(),
+                Some(label.to_string()),
+            )
+        })
+        .collect();
+    let cell = crate::history_cell::UserHistoryCell {
+        message,
+        text_elements,
+        local_image_paths: paths.clone(),
+        remote_image_urls: Vec::new(),
+        presentation: Default::default(),
+    };
+    let links: Vec<_> = cell
+        .transcript_hyperlink_lines(90)
+        .into_iter()
+        .flat_map(|line| line.hyperlinks)
+        .collect();
+    assert_eq!(links.len(), 2);
+    let mut app = crate::app::test_support::make_test_app().await;
+    app.chat_widget
+        .set_pet_image_support_for_tests(PetImageSupport::Supported(ImageProtocol::Kitty));
+    for (link, path) in links.iter().zip(paths) {
+        assert_eq!(
+            url::Url::parse(&link.destination)?.to_file_path().ok(),
+            Some(path.canonicalize()?)
+        );
+        app.open_url_in_browser(link.destination.clone());
+        assert!(matches!(
+            app.overlay.take(),
+            Some(crate::pager_overlay::Overlay::Image(_))
+        ));
+    }
+    Ok(())
+}
