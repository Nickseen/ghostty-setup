@@ -0,0 +1,80 @@
+//! A local attachment opens above the conversation without changing its draft or scroll position.
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use crossterm::event::{KeyCode, KeyEventKind};
+use ratatui::layout::Rect;
+use ratatui::style::{Color, Style};
+use ratatui::widgets::{Block, Borders, Clear, Paragraph, Widget};
+
+use crate::pets::ImageProtocol;
+use crate::transcript_image::{ImagePlacement, TranscriptImage};
+use crate::tui::{Tui, TuiEvent};
+
+pub(crate) struct ImagePreview {
+    path: PathBuf,
+    protocol: ImageProtocol,
+    cached: Option<(Rect, Option<Arc<TranscriptImage>>)>,
+    pub(crate) is_done: bool,
+}
+
+impl ImagePreview {
+    pub(crate) fn new(path: PathBuf, protocol: ImageProtocol) -> Self {
+        Self {
+            path,
+            protocol,
+            cached: None,
+            is_done: false,
+        }
+    }
+
+    pub(crate) fn handle_event(&mut self, tui: &mut Tui, event: TuiEvent) -> std::io::Result<()> {
+        match event {
+            TuiEvent::Key(key) if key.kind != KeyEventKind::Release => {
+                if matches!(key.code, KeyCode::Esc | KeyCode::Enter | KeyCode::Char('q')) {
+                    self.is_done = true;
+                }
+            }
+            TuiEvent::Draw | TuiEvent::Resize(_) | TuiEvent::Resume | TuiEvent::FocusGained => {
+                tui.draw(u16::MAX, |frame| {
+                    let area = frame.area();
+                    Clear.render(area, frame.buffer);
+                    let title = self.path.file_name().unwrap_or_default().to_string_lossy();
+                    let block = Block::default()
+                        .borders(Borders::ALL)
+                        .border_style(Style::default().fg(Color::Cyan))
+                        .title(format!(" {title} "))
+                        .title_bottom(" Esc / Enter — вернуться в чат ");
+                    let inner = block.inner(area);
+                    block.render(area, frame.buffer);
+                    if self.cached.as_ref().is_none_or(|(old, _)| *old != inner) {
+                        self.cached = Some((
+                            inner,
+                            TranscriptImage::load_large(&self.path, inner, self.protocol)
+                                .map(Arc::new),
+                        ));
+                    }
+                    if let Some((_, Some(image))) = &self.cached {
+                        let bounds = Rect::new(
+                            inner.x + inner.width.saturating_sub(image.columns) / 2,
+                            inner.y + inner.height.saturating_sub(image.rows) / 2,
+                            image.columns.min(inner.width),
+                            image.rows.min(inner.height),
+                        );
+                        frame.image_placements.push(ImagePlacement {
+                            image: Arc::clone(image),
+                            area: bounds,
+                            first_row: 0,
+                            file: None,
+                        });
+                    } else {
+                        Paragraph::new("Не удалось прочитать изображение")
+                            .render(inner, frame.buffer);
+                    }
+                })?;
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+}
