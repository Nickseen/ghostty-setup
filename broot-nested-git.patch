+/// Resolve only visited paths, and read each nested repository once per tree build.
+/// A clean nested repository must not inherit its parent's untracked status.
+pub struct NestedLineStatusComputer {
+    repositories: FxHashMap<PathBuf, Option<LineStatusComputer>>,
+    directories: FxHashMap<PathBuf, Option<PathBuf>>,
+}
+
+impl NestedLineStatusComputer {
+    pub fn new() -> Self {
+        Self {
+            repositories: FxHashMap::default(),
+            directories: FxHashMap::default(),
+        }
+    }
+
+    fn repository_dir(&mut self, directory: &Path) -> Option<PathBuf> {
+        let mut current = directory;
+        let mut visited = Vec::new();
+        let found = loop {
+            if let Some(cached) = self.directories.get(current) {
+                break cached.clone();
+            }
+            visited.push(current.to_path_buf());
+            // Worktrees and submodules use a .git file, ordinary repos a directory.
+            if current.join(".git").exists() {
+                break Some(current.to_path_buf());
+            }
+            match current.parent() {
+                Some(parent) => current = parent,
+                None => break None,
+            }
+        };
+        for path in visited {
+            self.directories.insert(path, found.clone());
+        }
+        found
+    }
+
+    pub fn line_status(&mut self, path: &Path) -> Option<LineGitStatus> {
+        let is_dir = path.is_dir();
+        let directory = if is_dir { path } else { path.parent()? };
+        let root = self.repository_dir(directory)?;
+        let computer = self.repositories.entry(root.clone())
+            .or_insert_with(|| LineStatusComputer::from_root(&root)).as_ref()?;
+        let exact = computer.line_status(path);
+        if exact.is_some() || !is_dir {
+            return exact;
+        }
+        // Bubble a real change up to its containing folder, including a closed repo.
+        // Ignored files alone must not make a clean repository look dirty.
+        computer.interesting_statuses.iter()
+            .filter(|(item, status)| item.starts_with(path) && **status != LineGitStatus::Ignored)
+            .map(|(_, status)| *status)
+            .max_by_key(|status| status.rank())
+    }
+
+    pub fn is_interesting(&mut self, path: &Path) -> bool {
+        self.line_status(path).is_some()
+    }
+}
+
